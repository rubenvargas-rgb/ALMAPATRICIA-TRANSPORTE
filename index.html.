            const text = `Hola Alma Patricia Joya Uribe Transportes, solicito cotización para:%0A- Origen: ${calculatedDetails.origin}%0A- Destino: ${calculatedDetails.destination}%0A- Peso: ${calculatedDetails.weight} Toneladas%0A- Estimado obtenido: $${calculatedDetails.price} MXN`;
            window.open(`https://wa.me/523338090757?text=${text}`, '_blank');
        }

        function handleQuickQuote(e) {
            e.preventDefault();
            document.getElementById('modal-success-title').textContent = "¡Solicitud Recibida!";
            document.getElementById('modal-success-desc').textContent = "Gracias por comunicarte con Alma Patricia Joya Uribe Transportes. Un ejecutivo se pondrá en contacto a la brevedad.";
