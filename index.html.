        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }
    </script>

    <script>
    (() => {
        const cities = [{lat:20.6597,lon:-103.3496},{lat:23.2494,lon:-106.4111},{lat:24.1426,lon:-110.3128},{lat:19.4326,lon:-99.1332}];
        const select = document.getElementById('weather-city');
        const reading = document.getElementById('weather-reading');
        const timestamp = document.getElementById('weather-time');
        const button = document.getElementById('weather-refresh');
        let activeRequest;
        function condition(code) {
            if (code === 0) return 'Despejado';
            if (code <= 3) return 'Parcialmente nublado / nublado';
            if ([45,48].includes(code)) return 'Niebla';
            if ([51,53,55,56,57].includes(code)) return 'Llovizna';
            if ([61,63,65,66,67,80,81,82].includes(code)) return 'Lluvia';
            if ([71,73,75,77,85,86].includes(code)) return 'Nieve';
            if ([95,96,99].includes(code)) return 'Tormenta';
            return 'Condiciones variables';
        }
        async function updateWeather() {
            if (activeRequest) activeRequest.abort();
            const controller = new AbortController();
            activeRequest = controller;
            const timeout = setTimeout(() => controller.abort(), 12000);
            reading.textContent = 'Consultando clima…';
            button.disabled = true;
            const city = cities[Number(select.value)];
            try {
                const url = `https://api.open-meteo.com/v1/forecast?latitude=${city.lat}&longitude=${city.lon}&current=temperature_2m,weather_code,wind_speed_10m&timezone=auto`;
                const response = await fetch(url, {signal:controller.signal});
                if (!response.ok) throw new Error('Servicio no disponible');
                const data = await response.json();
                const current = data.current;
                if (!current || !Number.isFinite(current.temperature_2m) || !Number.isFinite(current.wind_speed_10m) || !Number.isFinite(current.weather_code)) throw new Error('Datos incompletos');
                if (activeRequest !== controller) return;
                reading.textContent = `${Math.round(current.temperature_2m)} °C · ${condition(current.weather_code)} · Viento ${Math.round(current.wind_speed_10m)} km/h`;
                timestamp.textContent = `Datos: ${current.time.replace('T',' ')} (hora local) · Cada 15 min`;
            } catch (error) {
                if (activeRequest !== controller) return;
                reading.textContent = 'Clima no disponible. Intenta actualizar.';
                timestamp.textContent = 'Se requiere conexión a internet';
            } finally {
                clearTimeout(timeout);
                if (activeRequest === controller) button.disabled = false;
            }
        }
        select.addEventListener('change', updateWeather);
        button.addEventListener('click', updateWeather);
        setInterval(updateWeather, 15 * 60 * 1000);
        updateWeather();
    })();
    </script>

