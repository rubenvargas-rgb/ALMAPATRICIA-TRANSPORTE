                    <a href="#nosotros" class="hover:text-amber-600 transition">Nosotros</a>
                    <a href="#servicios" class="hover:text-amber-600 transition">Servicios</a>
                    <a href="#flota" class="hover:text-amber-600 transition">Flota</a>
                    <a href="#rastreo" class="hover:text-amber-600 transition flex items-center gap-1 font-bold text-amber-600">
                        <i class="fa-solid fa-satellite-dish animate-pulse"></i> Rastreo
                    </a>
                    <a href="#cotizador" class="hover:text-amber-600 transition">Cotizador</a>
                    <a href="#empleo" class="hover:text-amber-600 transition font-bold text-slate-800 bg-amber-50 px-3 py-1 rounded-lg border border-amber-200">
                        <i class="fa-solid fa-briefcase text-amber-600 mr-1"></i> Empleos
                    </a>
                    <a href="#contacto" class="hover:text-amber-600 transition">Ubicaciones</a>
                </nav>

                <!-- Actions -->
                <div class="hidden sm:flex items-center space-x-3">
                    <a href="#cotizador" class="bg-amber-500 hover:bg-amber-600 text-white font-semibold px-5 py-2.5 rounded-xl transition shadow-md shadow-amber-500/20 flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-calculator"></i> Cotizar Flete
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn" class="lg:hidden text-slate-700 p-2 rounded-lg hover:bg-slate-100">
                    <i class="fa-solid fa-bars text-2xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Nav Drawer -->
        <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-6 space-y-3">
            <a href="#inicio" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Inicio</a>
            <a href="#nosotros" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Nosotros</a>
            <a href="#servicios" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Servicios</a>
            <a href="#flota" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Flota</a>
            <a href="#rastreo" onclick="toggleMobileMenu()" class="block py-2 text-amber-600 font-bold hover:text-amber-700">Rastreo de Carga</a>
            <a href="#cotizador" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Cotizador</a>
            <a href="#empleo" onclick="toggleMobileMenu()" class="block py-2 text-amber-600 font-bold hover:text-amber-700"><i class="fa-solid fa-briefcase mr-1"></i> Bolsa de Trabajo</a>
            <a href="#faq" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Preguntas Frecuentes</a>
            <a href="#contacto" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium hover:text-amber-600">Ubicaciones</a>
            <a href="#cotizador" onclick="toggleMobileMenu()" class="block w-full text-center bg-amber-500 text-white font-semibold py-3 rounded-xl shadow mt-4">
                Solicitar Cotización
            </a>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="inicio" class="hero-bg min-h-[85vh] flex items-center relative text-white py-20 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                
                <div class="lg:col-span-7 space-y-6">
                    <div class="inline-flex items-center gap-2 bg-amber-500/20 border border-amber-400/30 text-amber-300 px-4 py-1.5 rounded-full text-sm font-medium backdrop-blur-md">
                        <i class="fa-solid fa-shield-halved"></i> Transporte de Carga & Logística Especializada
                    </div>
                    
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight">
                        Línea de Transporte <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">
                            Rápida, Segura y Eficiente
                        </span>
                    </h1>
                    
                    <p class="text-slate-200 text-lg sm:text-xl max-w-2xl font-light">
                        Soluciones integrales de fletes terrestres, transporte refrigerado y logística nacional bajo la Razón Social de <strong class="text-amber-400 font-semibold">Alma Patricia Joya Uribe</strong>.
                    </p>

                    <div class="flex flex-wrap gap-4 pt-4">
                        <a href="#cotizador" class="bg-amber-500 hover:bg-amber-600 text-white text-lg font-semibold px-8 py-4 rounded-xl shadow-lg transition flex items-center gap-3">
                            <i class="fa-solid fa-calculator"></i> Cotizador en Línea
                        </a>
                    </div>

                    <div class="pt-8 grid grid-cols-3 gap-4 border-t border-white/15 mt-8">
                        <div>
                            <span class="text-3xl sm:text-4xl font-extrabold text-amber-400 block">+15</span>
                            <span class="text-xs sm:text-sm text-slate-300">Años de experiencia</span>
                        </div>
                        <div>
                            <span class="text-3xl sm:text-4xl font-extrabold text-amber-400 block">100%</span>
                            <span class="text-xs sm:text-sm text-slate-300">Monitoreo Satelital</span>
                        </div>
                        <div>
                            <span class="text-3xl sm:text-4xl font-extrabold text-amber-400 block">99.8%</span>
                            <span class="text-xs sm:text-sm text-slate-300">Puntualidad en Entregas</span>
                        </div>
                    </div>
                </div>

                <!-- Fast Contact Box -->
                <div class="lg:col-span-5">
                    <div class="custom-glass rounded-3xl p-6 sm:p-8 text-slate-800 shadow-2xl border border-white/40">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-xl font-bold text-brand-navy">Solicitar Asesoría Directa</h3>
                            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span> Activo
                            </span>
                        </div>
                        <form onsubmit="handleQuickQuote(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Nombre Completo</label>
                                <input type="text" required placeholder="Ej. Carlos Mendoza" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 transition">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Teléfono / WhatsApp</label>
                                <input type="tel" required placeholder="(33) 0000-0000" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 transition">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Tipo de Servicio Requerido</label>
                                <select class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 transition">
                                    <option>Carga General / Caja Seca</option>
                                    <option>Carga Refrigerada ThermoKing</option>
                                    <option>Plataforma Carga Pesada</option>
                                    <option>Flete Dedicado Nacional</option>
                                </select>
                            </div>
                            <button type="submit" class="w-full bg-brand-navy hover:bg-brand-blue text-white font-bold py-3.5 rounded-xl transition shadow-md flex items-center justify-center gap-2">
                                <i class="fa-solid fa-paper-plane"></i> Contactar Ejecutivo
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Tipos de carga -->
    <section class="py-10 bg-amber-500 text-slate-900 border-y border-amber-600">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-2 gap-6 items-stretch">
                <!-- Carga refrigerada -->
                <div class="bg-white/95 rounded-2xl p-6 shadow-md border border-amber-200 flex gap-4 items-start">
                    <div class="w-12 h-12 rounded-xl bg-brand-navy text-amber-400 flex items-center justify-center text-xl shrink-0 mt-1">
                        <i class="fa-solid fa-snowflake"></i>
                    </div>
                    <div>
                        <span class="text-xs uppercase font-extrabold tracking-wider text-amber-700 block mb-1">Carga refrigerada</span>
                        <h4 class="text-lg font-bold text-slate-900 mb-1">Frescura durante el traslado</h4>
                        <p class="text-sm text-slate-700 leading-relaxed font-medium">
                            Fruta, verdura, perecederos y congelados. Indícanos la temperatura requerida para tu mercancía.
                        </p>
                    </div>
                </div>

                <!-- Carga seca -->
                <div class="bg-white/95 rounded-2xl p-6 shadow-md border border-amber-200 flex gap-4 items-start">
                    <div class="w-12 h-12 rounded-xl bg-brand-blue text-white flex items-center justify-center text-xl shrink-0 mt-1">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>
                    <div>
                        <span class="text-xs uppercase font-extrabold tracking-wider text-amber-700 block mb-1">Carga seca</span>
                        <h4 class="text-lg font-bold text-slate-900 mb-1">Espacio para tu mercancía</h4>
                        <p class="text-sm text-slate-700 leading-relaxed font-medium">
                            Abarrotes y productos que no requieren refrigeración. Indícanos el peso, volumen y destino de tu envío.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Live Tracking Section -->
    <section id="rastreo" class="py-20 bg-slate-900 text-white relative border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="bg-amber-500/20 text-amber-400 border border-amber-500/30 font-bold px-3 py-1 rounded-full uppercase text-xs tracking-wider inline-block mb-2">
                    <i class="fa-solid fa-satellite-dish mr-1"></i> Monitoreo GPS en Tiempo Real
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Sistema de Rastreo de Carga</h2>
                <p class="text-slate-400 mt-2 text-sm">Ingresa tu número de guía o Carta Porte para consultar el estatus en vivo de tu unidad.</p>
            </div>

            <!-- Tracking Input Box -->
            <div class="max-w-2xl mx-auto bg-slate-800 p-4 sm:p-6 rounded-2xl border border-slate-700 shadow-xl mb-10">
                <form onsubmit="trackShipment(event)" class="flex flex-col sm:flex-row gap-3">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-barcode absolute left-4 top-3.5 text-slate-400"></i>
                        <input type="text" id="tracking-input" required placeholder="Ej. JOY-9842 o Carta Porte #..." class="w-full pl-11 pr-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 uppercase">
                    </div>
                    <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-6 py-3 rounded-xl transition flex items-center justify-center gap-2 shrink-0">
                        <i class="fa-solid fa-magnifying-glass font-bold"></i> Rastrear
                    </button>
                </form>
                <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
                    <span>¿Quieres probar? Haz clic en una guía de ejemplo:</span>
                    <div class="flex gap-2">
                        <button onclick="fillAndTrack('JOY-9842')" class="text-amber-400 underline hover:text-amber-300">JOY-9842</button>
                        <button onclick="fillAndTrack('JOY-5510')" class="text-amber-400 underline hover:text-amber-300">JOY-5510</button>
                    </div>
                </div>
            </div>

            <!-- Tracking Result Display Container -->
            <div id="tracking-result" class="hidden max-w-4xl mx-auto bg-slate-800/90 rounded-3xl border border-slate-700 p-6 sm:p-8 shadow-2xl">
                <!-- Status Header -->
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-700 pb-6 mb-6">
                    <div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-slate-400 font-bold uppercase">Nº de Guía:</span>
                            <span class="text-amber-400 font-mono font-bold text-lg" id="res-code">JOY-9842</span>
                            <span id="res-badge" class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold px-2.5 py-0.5 rounded-full">En Tránsito</span>
                        </div>
                        <h3 class="text-xl font-bold text-white mt-1" id="res-route">Guadalajara (Jal) &rarr; Monterrey (N.L.)</h3>
                    </div>
                    <div class="text-left md:text-right">
                        <span class="text-xs text-slate-400 block">Estimado de Entrega</span>
                        <span class="text-sm font-bold text-slate-200" id="res-eta">Hoy, 18:30 hrs</span>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="mb-8">
                    <div class="flex justify-between text-xs font-bold text-slate-400 mb-2">
                        <span>Origen</span>
                        <span id="res-progress-text" class="text-amber-400">Progreso 65%</span>
                        <span>Destino</span>
                    </div>
                    <div class="w-full bg-slate-700 h-3 rounded-full overflow-hidden p-0.5">
                        <div id="res-progress-bar" class="bg-gradient-to-r from-amber-500 to-emerald-400 h-full rounded-full transition-all duration-1000" style="width: 65%;"></div>
                    </div>
                </div>

                <!-- Technical Live Details -->
                <div class="grid md:grid-cols-3 gap-4 text-xs">
                    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="text-slate-400 block mb-1"><i class="fa-solid fa-truck text-amber-500 mr-1"></i> Unidad & Placas</span>
                        <strong class="text-white text-sm block" id="res-truck">Kenworth T680 (33-AA-8J)</strong>
                        <span class="text-slate-400" id="res-type">Caja Seca 53FT</span>
                    </div>

                    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="text-slate-400 block mb-1"><i class="fa-solid fa-user-check text-emerald-400 mr-1"></i> Operador Certificado</span>
                        <strong class="text-white text-sm block" id="res-driver">Roberto M. Ramírez</strong>
                        <span class="text-emerald-400"><i class="fa-solid fa-shield-check"></i> Credenciales Validadas</span>
                    </div>

                    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="text-slate-400 block mb-1"><i class="fa-solid fa-location-dot text-red-400 mr-1"></i> Última Ubicación GPS</span>
                        <strong class="text-white text-sm block" id="res-location">Km 184 Carretera Saltillo</strong>
                        <span class="text-slate-400" id="res-speed">Velocidad: 82 km/h</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="nosotros" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="space-y-6">
                    <span class="text-amber-600 font-bold tracking-wider uppercase text-sm">Respaldo y Seguridad</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-navy leading-tight">
                        Expertos en Transporte de Carga Terrestre
                    </h2>
                    <p class="text-slate-600 leading-relaxed">
                        Bajo la Razón Social de <strong class="text-brand-navy">Alma Patricia Joya Uribe</strong>, nos especializamos en la logística y transportación terrestre de mercancías a nivel regional y nacional. Brindamos confianza, riguroso control en tiempos de tránsito y mantenimiento constante de nuestra flota.
                    </p>
                    
                    <div class="space-y-4 pt-2">
                        <div class="flex gap-4 items-start">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-lg shrink-0 mt-1">
                                <i class="fa-solid fa-satellite-dish"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-brand-navy text-lg">Monitoreo Satelital GPS 24/7</h4>
                                <p class="text-slate-500 text-sm">Rastreabilidad total e informes de ubicación en tiempo real durante todo el recorrido.</p>
                            </div>
                        </div>

                        <div class="flex gap-4 items-start">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 text-brand-blue flex items-center justify-center font-bold text-lg shrink-0 mt-1">
                                <i class="fa-solid fa-user-shield"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-brand-navy text-lg">Operadores Certificados</h4>
                                <p class="text-slate-500 text-sm">Personal capacitado en maniobras de seguridad, manejo defensivo y normativa SCT.</p>
                            </div>
                        </div>

                        <div class="flex gap-4 items-start">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-lg shrink-0 mt-1">
