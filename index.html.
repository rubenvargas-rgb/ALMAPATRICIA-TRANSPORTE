                            </div>
                        </div>
                    </div>
                </div>

                <!-- Logistics Operation Images Grid -->
                <div class="grid grid-cols-2 gap-4">
                    <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80" alt="Almacén Logístico" class="rounded-2xl shadow-lg w-full h-64 object-cover">
                    <img src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=800&q=80" alt="Transporte de Carga Heavy Duty" class="rounded-2xl shadow-lg w-full h-64 object-cover mt-8">
                </div>
