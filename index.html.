                </select>
                <span id="weather-reading" role="status" aria-live="polite">Consultando clima…</span>
                <button id="weather-refresh" type="button" class="text-amber-400 hover:text-white underline px-2 py-1">Actualizar</button>
            </div>
            <div class="flex items-center gap-3 text-slate-400">
                <span id="weather-time">Actualización cada 15 min</span>
                <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white underline">Open-Meteo</a>
            </div>
        </div>
    </aside>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                
                <!-- NEW LOGO STRUCTURE -->
                <a href="#" class="flex items-center gap-3 group">
                    <div class="w-12 h-12 bg-gradient-to-tr from-brand-blue to-amber-500 rounded-xl flex items-center justify-center text-white text-2xl font-black shadow-md group-hover:scale-105 transition-transform">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <div>
                        <span class="text-xl sm:text-2xl font-extrabold tracking-tight text-brand-navy block leading-none">
                            ALMA PATRICIA <span class="text-amber-600">JOYA URIBE</span>
                        </span>
                        <span class="text-[11px] tracking-[0.25em] text-slate-500 font-bold uppercase block mt-1">
                            TRANSPORTES
                        </span>
