        // Freight Quote Calculator
        let calculatedDetails = {};

        function calculateQuote(e) {
            e.preventDefault();
            const origin = document.getElementById('calc-origin').value;
            const destination = document.getElementById('calc-destination').value;
            const typeFactor = parseFloat(document.getElementById('calc-type').value);
            const weight = parseFloat(document.getElementById('calc-weight').value);

            const baseDistanceEstimate = Math.floor(Math.random() * 400) + 350;
            const baseRatePerKm = 38;

            let totalEstimate = (baseDistanceEstimate * baseRatePerKm * typeFactor) + (weight * 250);
            totalEstimate = Math.round(totalEstimate / 100) * 100;

            calculatedDetails = {
                origin,
                destination,
                weight,
                price: totalEstimate.toLocaleString('es-MX')
            };

            document.getElementById('result-price').textContent = `$${calculatedDetails.price} MXN`;
            document.getElementById('quote-result').classList.remove('hidden');
        }

